# Copy this file to ".env" and customise values for your environment.
# Base configuration for local development.
APP_NAME=awd-infra
LOG_LEVEL=debug

# Control Panel
CONTROL_PANEL_LOG_OUTPUT_LIMIT=4096

# Storage / Queue
POSTGRES_ARTIFACT_DIR=/var/lib/awd/artifacts
REDIS_ADDR=redis:6379

# Secrets 
## PostgreSQL
POSTGRES_DB=awd
POSTGRES_USER=awd
POSTGRES_PASSWORD=awd
POSTGRES_DSN=postgres://awd:awd@postgres:5432/awd?sslmode=disable

## Redis
REDIS_PASSWORD=dev-redis-password

## Tokens and Secrets
CONTROL_PANEL_TOKEN=dev-admin-token
RUNNER_SECRET=dev-runner-secret
SUBMITTER_SECRET=dev-submitter-secret

# Scheduler
SCHEDULER_POLL_INTERVAL=5s
SCHEDULER_MAX_BATCH=50

