# Base configuration for local development.
APP_NAME=awd-infra
LOG_LEVEL=debug

# Storage / Queue
POSTGRES_DSN=postgres://awd:awd@postgres:5432/awd?sslmode=disable
POSTGRES_ARTIFACT_DIR=/var/lib/awd/artifacts
REDIS_ADDR=redis:6379
#REDIS_PASSWORD=

# Secrets
RUNNER_SECRET=dev-runner-secret

# Scheduler
SCHEDULER_POLL_INTERVAL=5s
SCHEDULER_MAX_BATCH=50

# Runner
RUNNER_ID=dev-runner
RUNNER_TYPE=python
CONTROL_PLANE_URL=http://control-plane:8080
RUNNER_MAX_PARALLEL=2
RUNNER_CHROOT_PATH=/env
RUNNER_WORKSPACE_ROOT=/env/tmp
RUNNER_FLAG_FILE=flag
RUNNER_FLAG_REGEX=flag\{[a-zA-Z0-9_\-]+\}
RUNNER_DEFAULT_TIMEOUT=120s
RUNNER_TAGS=python,pwntools

# Flag Submitter
FLAG_SUBMIT_GLOBAL_RATE=5
FLAG_SUBMIT_PER_CHALLENGE=2
FLAG_SUBMIT_RETRY_BACKOFF=10s
FLAG_SUBMIT_MAX_ATTEMPTS=5
FLAG_SUBMIT_URL=http://192.168.66.206:5000/upload_flag
FLAG_SUBMIT_TIMEOUT=3s
FLAG_SUBMIT_CONCURRENCY=10
